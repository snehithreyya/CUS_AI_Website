{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": [
        "http://localhost/index.html",
        "http://localhost/404.html",
        "http://localhost/about.html",
        "http://localhost/booking.html",
        "http://localhost/careers.html",
        "http://localhost/cloud-solutions.html",
        "http://localhost/contact.html",
        "http://localhost/engineering-services.html",
        "http://localhost/faq.html",
        "http://localhost/industries.html",
        "http://localhost/insights-ai-adoption.html",
        "http://localhost/insights-cloud-cost.html",
        "http://localhost/insights-cybersecurity-resilience.html",
        "http://localhost/insights-legacy-modernization.html",
        "http://localhost/insights-new-grad-portfolio.html",
        "http://localhost/insights-regulated-industries.html",
        "http://localhost/insights-sre-reliability.html",
        "http://localhost/insights-tech-staffing.html",
        "http://localhost/insights.html",
        "http://localhost/privacy.html",
        "http://localhost/services.html",
        "http://localhost/software-development.html",
        "http://localhost/students.html",
        "http://localhost/technology-consulting.html",
        "http://localhost/terms.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*/404\\.html$).*$",
          "assertions": {
            "categories:performance": ["error", {"minScore": 0.9}],
            "categories:accessibility": ["error", {"minScore": 1}],
            "categories:best-practices": ["error", {"minScore": 0.95}],
            "categories:seo": ["error", {"minScore": 1}],
            "largest-contentful-paint": ["warn", {"maxNumericValue": 2500}],
            "cumulative-layout-shift": ["error", {"maxNumericValue": 0.1}],
            "total-blocking-time": ["warn", {"maxNumericValue": 200}],
            "resource-summary:total:size": ["error", {"maxNumericValue": 460800}],
            "resource-summary:script:size": ["error", {"maxNumericValue": 61440}],
            "resource-summary:stylesheet:size": ["error", {"maxNumericValue": 40960}],
            "resource-summary:font:size": ["error", {"maxNumericValue": 163840}],
            "resource-summary:image:size": ["error", {"maxNumericValue": 204800}],
            "resource-summary:third-party:count": ["error", {"maxNumericValue": 0}]
          }
        },
        {
          "matchingUrlPattern": "/404\\.html$",
          "assertions": {
            "categories:performance": ["error", {"minScore": 0.9}],
            "categories:accessibility": ["error", {"minScore": 1}],
            "categories:best-practices": ["error", {"minScore": 0.95}],
            "categories:seo": "off",
            "largest-contentful-paint": ["warn", {"maxNumericValue": 2500}],
            "cumulative-layout-shift": ["error", {"maxNumericValue": 0.1}],
            "total-blocking-time": ["warn", {"maxNumericValue": 200}],
            "resource-summary:total:size": ["error", {"maxNumericValue": 460800}],
            "resource-summary:script:size": ["error", {"maxNumericValue": 61440}],
            "resource-summary:stylesheet:size": ["error", {"maxNumericValue": 40960}],
            "resource-summary:font:size": ["error", {"maxNumericValue": 163840}],
            "resource-summary:image:size": ["error", {"maxNumericValue": 204800}],
            "resource-summary:third-party:count": ["error", {"maxNumericValue": 0}],
            "document-title": ["error", {"minScore": 1}],
            "meta-description": ["error", {"minScore": 1}],
            "http-status-code": ["error", {"minScore": 1}],
            "link-text": ["error", {"minScore": 1}],
            "crawlable-anchors": ["error", {"minScore": 1}],
            "robots-txt": ["error", {"minScore": 1}],
            "hreflang": ["error", {"minScore": 1}],
            "canonical": ["error", {"minScore": 1}],
            "is-crawlable": "off"
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
