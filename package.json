{
  "name": "cus-ai-website",
  "private": true,
  "description": "CUS Solution marketing site \u2014 static HTML. npm is only used to precompile Tailwind CSS.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o css/tailwind.css --watch",
    "lighthouse": "npx --yes @lhci/cli@0.15.1 autorun --config=lighthouserc.json",
    "lighthouse:mobile": "npx --yes @lhci/cli@0.15.1 autorun --config=lighthouserc.mobile.json",
    "lighthouse:all": "npm run lighthouse && npm run lighthouse:mobile"
  },
  "devDependencies": {
    "tailwindcss": "3.4.19"
  }
}
